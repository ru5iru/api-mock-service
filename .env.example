APP_NAME=MockDeck
APP_ENV=local
APP_KEY=base64:replace-with-32-random-bytes-in-base64
APP_DEBUG=true
APP_URL=http://localhost:18473
APP_PORT=18473
BUILD_APP_ENV=local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mock_api
DB_USERNAME=mock_api
DB_PASSWORD=mock_api

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MOCK_LOG_STDOUT=true
MOCK_LOG_FILE=true
MOCK_LOG_DAYS=14
MOCK_MAX_DELAY_MS=30000
MOCK_DASHBOARD_AUTH_ENABLED=true
MOCK_DASHBOARD_USERNAME=admin
MOCK_DASHBOARD_PASSWORD=change-this-too
RUN_MIGRATIONS=true
