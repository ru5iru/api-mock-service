APP_NAME=MockDeck
APP_ENV=local
APP_KEY=base64:replace-with-32-random-bytes-in-base64
APP_DEBUG=true
APP_URL=http://localhost:18473
APP_PORT=18473
BUILD_APP_ENV=local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mock_api
DB_USERNAME=mock_api
DB_PASSWORD=replace-this-too

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MOCK_LOG_STDOUT=true
MOCK_LOG_FILE=true
MOCK_LOG_DAYS=14
MOCK_TEMPLATE_MAX_BYTES=262144
MOCK_TEMPLATE_MAX_DEPTH=12
MOCK_TEMPLATE_MAX_NODES=10000
MOCK_TEMPLATE_MAX_RENDERED_NODES=100000
MOCK_TEMPLATE_MAX_REPEAT=1000
MOCK_TEMPLATE_MAX_ARGS_BYTES=4096
MOCK_TEMPLATE_MAX_OUTPUT_BYTES=1048576
MOCK_MAX_DELAY_MS=30000
MOCK_CONFIG_MAX_BYTES=2097152
MOCK_CONFIG_MAX_ENDPOINTS=500
MOCK_CONFIG_MAX_RESPONSES=5000
MOCK_CONFIG_MAX_STRING_BYTES=1048576
MOCK_CONFIG_PREVIEW_TTL=900
MOCK_EXPORT_SENSITIVE_HEADERS=authorization,proxy-authorization,cookie,set-cookie,x-api-key,api-key,x-auth-token
MOCK_EXPORT_SENSITIVE_QUERY_KEYS=access_token,api_key,apikey,auth_token,key,token
MOCK_DASHBOARD_AUTH_ENABLED=true
MOCK_DASHBOARD_USERNAME=admin
MOCK_DASHBOARD_PASSWORD=change-this-too
RUN_MIGRATIONS=true
